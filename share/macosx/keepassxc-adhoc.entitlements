<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allows loading unsigned or differently-signed third-party dylibs (libqrencode, Qt, etc.)
	     under Hardened Runtime without crashing due to Team ID mismatch on ad-hoc builds -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
